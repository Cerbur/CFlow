{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cflow://schemas/discussion-handoff.json",
  "title": "Discussion handoff",
  "description": "Strict contract of one finished native requirement discussion handoff Artifact (design §9.2, TUI task 12). Plan generation consumes this structured handoff — targets, constraints, non-goals, acceptance criteria, open questions, the frozen Change Set Ref, and the user's decisions — never a terminal transcript. The handoff body is canonical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "session_id",
    "targets",
    "constraints",
    "non_goals",
    "acceptance_criteria",
    "open_questions",
    "change_set",
    "user_decisions"
  ],
  "properties": {
    "workflow_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "targets": { "type": "string", "minLength": 1 },
    "constraints": { "type": "string", "minLength": 1 },
    "non_goals": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "string", "minLength": 1 },
    "open_questions": { "type": "string" },
    "change_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "sha256"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "minLength": 64 }
      }
    },
    "user_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "decision"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
