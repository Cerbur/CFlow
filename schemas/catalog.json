{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cflow://schemas/catalog.json",
  "title": "Verification Command Catalog",
  "description": "Body contract of one Verification Catalog Artifact (PRD 已确认：Workflow-local Verification Command Catalog). Every external Verification Command must be a named entry here before any Spec or Workflow may reference it by command_id; entries never carry shell command strings, pipes, redirects, command substitution, or implicit shell execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "entries"],
  "properties": {
    "revision": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "executable",
          "args",
          "cwd",
          "purpose",
          "timeout_seconds",
          "expected_exit_codes",
          "max_output_bytes",
          "source"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "executable": { "type": "string", "minLength": 1 },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "purpose": {
            "type": "string",
            "enum": [
              "task_verify",
              "integration_verify",
              "final_verify",
              "apply_verify"
            ]
          },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "expected_exit_codes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer" }
          },
          "max_output_bytes": { "type": "integer", "minimum": 1 },
          "env": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          },
          "transient_write_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
